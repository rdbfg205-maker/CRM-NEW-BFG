# BASPAR FOAM SMART CRM — environment configuration
# Copy to .env and adjust as needed. All variables are optional.

# HTTP port (default 3050)
PORT=3050

# Where database, backups and uploads live (relative to project root or absolute)
DATA_DIR=./data
# DB_PATH=./data/baspar-crm.sqlite

# 1 = seed demo dataset on first run (removable from Admin -> Settings)
SEED_DEMO=1

# Fixed secret for multi-instance deployments (auto-generated otherwise)
# JWT_SECRET=change-me-to-a-long-random-string
