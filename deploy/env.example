# BASPAR FOAM SMART CRM — Environment Template
# کپی کنید:  cp deploy/env.example /etc/baspar-crm/env
# فقط مقادیر خالی را پر کنید. این فایل نباید در Git/ZIP قرار بگیرد (مقادیر واقعی).
# نحوهٔ مصرف: systemd EnvironmentFile= یا source در shell (dotenv در پروژه استفاده نمی‌شود — بدون dependency اضافه)

# --- حالت اجرا ---
NODE_ENV=production

# --- شبکه ---
# پورت HTTP داخلی (Reverse Proxy به این پورت forward می‌کند)
PORT=3000
# Bind host: در Production روی 127.0.0.1 باشد تا اپ روی اینترنت مستقیم نباشد (فقط nginx دسترسی دارد)
HOST=127.0.0.1

# --- منطقه زمانی (برای تاریخ‌های شمسی/لوگ/بکاپ) ---
TZ=Asia/Tehran

# --- دیتابیس ---
# مسیر فایل SQLite (نسبت به دایرکتوری پروژه یا مطلق). دیتابیس فایل محجور است — پورت شبکه ندارد.
DB_PATH=/var/lib/baspar-crm/baspar-crm.sqlite
# ریشهٔ دیتا (آپلود/ضبط/بکاپ) — باید خارج از web root باشد
DATA_DIR=/var/lib/baspar-crm

# --- Secrets (مقادیر واقعی فقط در /etc/baspar-crm/env با chmod 600) ---
# کلید امضای JWT — حتماً مقدار تصادفی 64+ کاراکتری بگذارید (نمونه: openssl rand -hex 32)
# اگر خالی باشد، از کلید ذخیره‌شده در دیتابیس (سازگاری با نصب‌های موجود) استفاده می‌شود.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- اختیاری ---
# در سنبوکس/Preview که اپ در iframe می‌جاسازد، ALLOWALL بگذارید؛ در Production پیش‌فرض DENY را نگه دارید
X_FRAME_OPTIONS=DENY
# Retention بکاپ‌ها (روز) — پیش‌فرض 30
#BACKUP_RETENTION_DAYS=30
# Seed دیتای دمو هنگام نصب اولیه (نصب‌های تازه)
SEED_DEMO=1
